# OSD Module Makefile

# OSD module object files
OSD_OBJECTS = obj/modules/osd/osd_module.o

# Add OSD module objects to the main build
OBJS += $(OSD_OBJECTS)

# OSD module compilation rules
obj/modules/osd/osd_module.o: src/modules/osd/osd_module.c src/modules/osd/osd_module.h
	@mkdir -p obj/modules/osd
	$(CC) $(CFLAGS) \
		-I$(LIBIMP_INC_DIR) \
		-I$(LIBIMP_INC_DIR)/imp \
		-I$(LIBIMP_INC_DIR)/sysutils \
		-isystem $(THIRDPARTY_INC_DIR) \
		-c $< -o $@

# Clean rule for OSD module
clean-osd:
	rm -f $(OSD_OBJECTS)

.PHONY: clean-osd
