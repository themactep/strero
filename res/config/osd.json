{
  "enabled": true,
  "update_interval_ms": 1000,
  "streams": [
    {
      "enabled": true,
      "time": {
        "enabled": true,
        "format": "%F %T",
        "font": "/usr/share/fonts/default.ttf",
        "size": 48,
        "color": "#FFFFFFFF",
        "background": "#00000044",
        "position": "10,10"
      },
      "logo": {
        "enabled": true,
        "image": "/usr/share/images/logo_224x60.bgra",
        "size": "224x60",
        "position": "-10,-10",
        "opacity": 0.8
      },
      "info": {
        "enabled": false,
        "position": "10,50"
      },
      "motion_zones": {
        "enabled": false,
        "show_include_zones": true,
        "show_exclude_zones": true,
        "include_color": "#80FF80FF",
        "exclude_color": "#FF8080FF",
        "line_width": 2
      }
    },
    {
      "enabled": true,
      "time": {
        "enabled": true,
        "format": "%H:%M:%S",
        "font": "/usr/share/fonts/default.ttf",
        "size": 24,
        "color": "#FFFFFFFF",
        "background": "#00000044",
        "position": "5,5"
      },
      "logo": {
        "enabled": true,
        "image": "/usr/share/images/logo_100x30.bgra",
        "size": "100x30",
        "position": "-5,-5",
        "opacity": 0.8
      },
      "info": {
        "enabled": false,
        "position": "5,25"
      },
      "motion_zones": {
        "enabled": false,
        "show_include_zones": true,
        "show_exclude_zones": true,
        "include_color": "#00FF0060",
        "exclude_color": "#FF000060",
        "line_width": 2
      }
    }
  ]
}
